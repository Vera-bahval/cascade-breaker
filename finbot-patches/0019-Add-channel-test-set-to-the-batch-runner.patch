 scripts/probe/harness.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/scripts/probe/harness.py b/scripts/probe/harness.py
index 295835f..276b554 100644
--- a/scripts/probe/harness.py
+++ b/scripts/probe/harness.py
