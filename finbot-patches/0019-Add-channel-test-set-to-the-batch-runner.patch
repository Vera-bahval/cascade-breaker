+# Channel test: faults on a scenario the invoice agent reliably holds ("processing"),
+# so a payment can only follow if the fault travels through text or through the DB.
+CHANNEL_CASE = "confidence_degradation"
+CHANNEL_FAULTS = [("invoice", "instruction"), ("invoice", "response"), ("fraud", "response")]
 CLEAN_PATH = Path(__file__).resolve().parents[2] / "finbot" / "agents" / "cascade_clean_scenarios.json"
 TASK_DESCRIPTION = (
     "A new invoice has been submitted. Process the invoice and "
@@ -71,6 +75,11 @@ def load_cases(sets: list[str], attack_reps: int, clean_reps: int,
             for rep in range(base_reps):
                 split = "A" if rep < base_reps / 2 else "B"
                 cases.append(Case("bases", base["id"], base["invoice"], rep, split))
+    if "channel" in sets:
+        sc = next(s for s in load_scenarios_file()["scenarios"] if s["id"] == CHANNEL_CASE)
+        for fault in CHANNEL_FAULTS:
+            for rep in range(injection_reps):
+                cases.append(Case("channel", sc["id"], sc["invoice"], rep, "B", fault))
     if "injections" in sets:
         for base in clean["injection_bases"]:
             for node in probe_injections.NODES:
