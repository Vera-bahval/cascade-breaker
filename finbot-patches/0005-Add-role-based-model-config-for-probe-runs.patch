--- /dev/null
+++ b/finbot/probe/roles.py
@@ -0,0 +1,38 @@
+"""Role -> model table for the cascade-control probe.
+
+Models come from a committed JSON config, not from code; the config hash goes
+into every trace so a run can be tied to the exact table it used.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+DEFAULT_ROLES_PATH = Path(__file__).parent / "roles.json"
+
+
+@dataclass(frozen=True)
+class RoleConfig:
+    default: str
+    roles: dict[str, str]
+    price_per_mtok: dict[str, float]
+    sha256: str
+
+    def model_for(self, role: str) -> str:
+        return self.roles.get(role, self.default)
+
+
+@lru_cache(maxsize=4)
+def load_roles(path: str | Path = DEFAULT_ROLES_PATH) -> RoleConfig:
+    raw = json.loads(Path(path).read_text(encoding="utf-8"))
+    canonical = json.dumps(raw, sort_keys=True, separators=(",", ":"))
+    return RoleConfig(
+        default=raw["default"],
+        roles=dict(raw.get("roles", {})),
+        price_per_mtok=dict(raw["price_per_mtok"]),
+        sha256=hashlib.sha256(canonical.encode()).hexdigest(),
+    )
diff --git a/tests/unit/probe/test_roles.py b/tests/unit/probe/test_roles.py
new file mode 100644
index 0000000..cec963d
--- /dev/null
+++ b/tests/unit/probe/test_roles.py
@@ -0,0 +1,15 @@
+"""Unit tests for the probe role -> model table."""
+
+import pytest
+
+from finbot.probe.roles import load_roles
+
+
+@pytest.mark.unit
+def test_committed_roles_cover_agents_and_verifiers():
+    roles = load_roles()
+    for role in ("orchestrator_agent", "invoice_agent", "fraud_agent",
+                 "payments_agent", "communication_agent", "verifier.v3"):
+        assert roles.model_for(role) == "openai/gpt-4o-mini-2024-07-18"
+    assert roles.model_for("unknown_agent") == roles.default
+    assert len(roles.sha256) == 64
