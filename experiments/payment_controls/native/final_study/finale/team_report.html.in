<title>Платёжные ошибки в FinBot: правила, Fraud и Jev</title>
<style>
:root{--ink:#132c31;--sub:#49626a;--teal:#166d62;--orange:#aa5330;--paper:#fbfaf6;--line:#ccd8d4}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.53 "Inter","Arial",sans-serif}main,nav>div,header>div{max-width:1150px;margin:auto;padding:0 5%}nav{border-bottom:1px solid var(--line)}nav>div{display:flex;gap:24px;align-items:center;min-height:58px;flex-wrap:wrap}nav b{margin-right:auto}a{color:var(--teal);text-underline-offset:4px}nav a{font-size:14px}details{padding:9px 0;border-bottom:1px solid var(--line)}details p{margin-left:12px}header{background:#123c3c;color:#f7faf5;padding:60px 0}h1,h2{font-family:Georgia,serif;letter-spacing:-.035em;line-height:1.05;margin:0}h1{font-size:clamp(41px,6vw,78px);max-width:900px}header p{max-width:800px;font-size:20px;color:#d6ebe4;margin-bottom:0}section{padding:38px 0 30px;border-bottom:1px solid var(--line)}h2{font-size:clamp(30px,4vw,46px);margin:0 0 16px}h3{font-size:19px;margin:20px 0 5px}p{margin:7px 0 14px}small,figcaption{color:var(--sub);font-size:14px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.tile{border-top:3px solid var(--teal);padding-top:9px}.tile strong{display:block;font:600 29px/1.22 Georgia,serif;margin:6px 0}.tile p{font-size:16px}.flow{display:flex;gap:5px;flex-wrap:wrap;align-items:stretch;margin:22px 0}.flow div{padding:10px 16px;background:#eaf0eb;border-radius:3px;flex:1;min-width:120px}.flow span{display:block;font-size:12px;color:var(--teal)}.bar{display:flex;height:27px;background:#edf0eb;border-radius:3px;overflow:hidden;margin:17px 0 9px}.bar i{display:block}.legend{display:flex;gap:12px 22px;flex-wrap:wrap;font-size:14px}.legend i{width:11px;height:11px;display:inline-block;margin-right:5px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;margin:12px 0;text-align:right;font-variant-numeric:tabular-nums;font-size:15px}th,td{padding:10px 9px;border-bottom:1px solid var(--line);vertical-align:top}th{font-size:13px;color:var(--sub);font-weight:600}td:first-child,th:first-child{text-align:left}tr:hover td{background:#f0f3ec}.forest-row{display:grid;grid-template-columns:52px 1fr 130px;align-items:center;gap:12px;font-size:14px}.axis{position:relative;height:31px;background:linear-gradient(to right,transparent 49.8%,#708882 50%,transparent 50.2%)}.range{position:absolute;height:5px;background:#48867c;top:13px;border-radius:4px}.estimate{position:absolute;width:10px;height:10px;border-radius:100%;top:10.5px;background:#173c36;transform:translateX(-50%)}.switch{display:flex;gap:6px;flex-wrap:wrap;margin-top:16px}button{border:1px solid var(--line);border-radius:999px;background:transparent;padding:8px 15px;cursor:pointer;color:var(--ink)}button[aria-pressed=true]{background:var(--ink);color:white}.note{padding:15px 18px;background:#edf3ed;border-left:3px solid var(--teal);margin:15px 0}.case{border-top:2px solid var(--orange);padding:10px 0}.case b{color:#783b26}.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}footer{padding:22px 0 40px;color:var(--sub);font-size:14px}summary{cursor:pointer;color:var(--teal)}:focus-visible{outline:3px solid #c76a35}@media(max-width:720px){.grid,.split{grid-template-columns:1fr;gap:12px}nav>div{gap:8px 14px;padding-top:9px;padding-bottom:9px}header{padding:32px 0}section{padding:29px 0}.flow div{min-width:100px}th,td{padding:7px 5px}}
@media print{nav,.switch{display:none}body{background:white;font-size:11pt}header{background:white;color:var(--ink);padding:12px 0}header p{color:var(--sub)}h1{font-size:30pt}h2{font-size:21pt}section{break-inside:avoid;padding:12px 0}.scroll{overflow:visible}}
.versus{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:18px 0}.versus strong{display:block}.meter{height:13px;background:#e4e9e5;border-radius:4px;overflow:hidden}.meter i{height:100%;display:block;background:var(--orange)}.versus small{display:block;margin:4px 0}@media(max-width:600px){.versus{grid-template-columns:1fr;gap:10px}}

.rulemap{min-width:570px}.rulemap td,.rulemap th{text-align:left}.rulemap td:first-child{font-weight:600;width:22%}.rulemap td:last-child{width:34%}
.source{font-size:14px}.case p{margin:5px 0 12px}.examples{margin-top:16px}h2{max-width:920px}
@media print{details>*,details::details-content{display:block;content-visibility:visible}nav{display:none}}

header{padding:34px 0}h1{font-size:clamp(36px,4.3vw,60px)}header p{font-size:18px}.tile strong{font-size:24px}section{padding:28px 0}.grid{gap:18px}.source{margin:10px 0 0}
.track{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.track>div,.fact{background:#eaf1ec;padding:12px 16px;border-radius:4px}.track strong,.fact strong{display:block;font-size:21px}.track span,.fact span{display:block;color:var(--sub)}.track .result{background:#dcece6}
.bars{max-width:720px}.measure{display:grid;grid-template-columns:100px 1fr 80px;gap:12px;align-items:center;margin:9px 0}.measure meter{width:100%;height:23px;accent-color:var(--teal)}meter::-webkit-meter-optimum-value{background:#247767}.measure b{font-variant-numeric:tabular-nums}.pairfig{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fact strong{font:600 28px Georgia,serif}.summaryline{max-width:840px}details{margin-top:10px}
