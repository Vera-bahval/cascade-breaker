+def render_safe_m2(context, args, description, fraud):
+    with database.db_session() as db:
+        invoice = InvoiceRepository(db, context).get_invoice(args["invoice_id"])
+        flags = [dict(action=flag.action, reason=flag.reason, note=flag.note) for flag in active_flags(db, invoice)]
+    with patch.object(archived_m2.RL, "active_flags", return_value=flags):
+        return description + (archived_m2.safe_block(None, fraud) or "")
