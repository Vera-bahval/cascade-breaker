+from sqlalchemy.exc import IntegrityError, SQLAlchemyError
+from sqlalchemy.orm import sessionmaker
+
+from finbot.config import settings
+from finbot.core.auth.session import SessionContext
+from finbot.core.data import database
+from finbot.core.data.models import Invoice
+from finbot.core.data.repositories import InvoiceRepository
+from finbot.core.data.transfer_flags import active_flags, begin_transfer_write, record_flag, release_flag
+from finbot.mcp.factory import create_mcp_server
+from finbot.mcp.servers.finstripe import server as stripe
+from finbot.tools.data.fraud import flag_invoice_for_review
+from finbot.tools.data.payment import process_payment
+
+STAND = Path(__file__).resolve().parents[1]
+LAB = Path(os.environ["CP3_SOURCE_LAB"]).resolve()
+sys.path.insert(0, str(LAB))
+import m2safety as archived_m2
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def checkpoint_db(scenario, destination):
+    source, result, delegation = archived_m2.source(scenario)
+    original = Path(source) / "run.db"
+    original_hash = digest(original)
+    wal = original.with_name("run.db-wal")
+    assert not wal.exists() or wal.stat().st_size == 0
+    shutil.copyfile(original, destination)
+    before = delegation["db_before"]
+    invoice_id = before["invoice"]["id"]
+    with sqlite3.connect(destination) as db:
+        db.execute("delete from payment_transactions where invoice_id=?", (invoice_id,))
+        db.execute("update invoices set status=?, agent_notes=? where id=?",
+                   (before["invoice"]["status"], before["invoice"]["agent_notes"], invoice_id))
+        vendor = before["vendor"]
+        db.execute("update vendors set status=?, trust_level=?, risk_level=?, agent_notes=? where id=?",
+                   (vendor["status"], vendor["trust_level"], vendor["risk_level"], vendor["agent_notes"], archived_m2.RL.VENDOR_ID))
+        saved = {email["id"] for email in before["emails"]}
+        post = {row[0] for row in db.execute("select id from emails")}
+        db.executemany("delete from emails where id=?", [(key,) for key in post - saved])
+        db.execute("update labs_guardrail_configs set enabled=0")
+        namespace, vendor_id, reference, amount = db.execute(
+            "select namespace,vendor_id,invoice_number,amount from invoices where id=?", (invoice_id,),
+        ).fetchone()
+        account, email = db.execute(
+            "select bank_account_number,email from vendors where id=?", (vendor_id,),
+        ).fetchone()
+    assert archived_m2.RL.db_state(str(destination), invoice_id) == before
+    assert digest(original) == original_hash
+    latest = delegation["task_data"]["description"]
+    fraud_texts = [item["result"].get("task_summary", "") for item in result["fraud_runs"]]
+    call = dict(invoice_id=invoice_id, vendor_id=vendor_id, vendor_account=account,
+                invoice_reference=reference, amount=amount)
+    return namespace, email, latest, fraud_texts, before, call, original_hash
+
+
+def identity(namespace, portal):
+    now = datetime.now(UTC)
+    return SessionContext(
+        session_id=f"cp3-{portal}", user_id=f"cp3-{portal}", is_temporary=False,
+        namespace=namespace, created_at=now, expires_at=now + timedelta(hours=1),
+        portal_type=portal,
+    )
+
+
+def use_database(monkeypatch, path):
+    url = f"sqlite:///{path}"
+    monkeypatch.setattr(settings, "DATABASE_URL", url)
+    engine = create_engine(url, connect_args={"timeout": 2})
+    monkeypatch.setattr(database, "SessionLocal", sessionmaker(bind=engine))
+    return engine
+
+
+def prepare(monkeypatch, scenario, path):
+    namespace, email, description, fraud, before, args, original_sha = checkpoint_db(scenario, path)
+    engine = use_database(monkeypatch, path)
+    config = Config(str(STAND / "alembic.ini"))
+    config.set_main_option("script_location", str(STAND / "migrations"))
+    command.upgrade(config, "head")
+    admin = identity(namespace, "admin")
+    with database.db_session() as db:
+        begin_transfer_write(db)
+        invoice = InvoiceRepository(db, admin).get_invoice(args["invoice_id"])
+        assert not invoice.transfer_flags_verified
+        flags = archived_m2.RL.active_flags(before["invoice"]["agent_notes"])
+        assert [item["action"] for item in flags] == (["escalate"] if scenario == "FD55" else [])
+        for flag in flags:
+            record_flag(db, invoice, flag["action"], flag["reason"], flag["note"], "verified_snapshot")
+        invoice.transfer_flags_verified = True
+        db.commit()
+    engine.dispose()
+    return admin, email, description, fraud, args, original_sha
+
+
+async def call_tool(context, server_type, name, arguments, target=None):
+    server = await create_mcp_server(server_type, context, authorized_invoice_id=target)
+    return await call_existing(server, name, arguments)
+
+
+async def call_existing(server, name, arguments):
+    async with Client(server) as client:
+        tools = await client.list_tools()
+        schema = next(tool.inputSchema for tool in tools if tool.name == name)
+        assert "authorized_invoice_id" not in schema.get("properties", {})
+        return (await client.call_tool(name, arguments)).data
