+    change_db(path, "update invoices set status='approved', amount=? where id=?", (args["amount"], target - 1))
+    with pytest.raises(ValueError, match="matching completed"):
+        run(process_payment(target - 1, "bank_transfer", reference, "", admin))
+    with ThreadPoolExecutor() as executor:
+        calls = [executor.submit(run, process_payment(target, "bank_transfer", reference, "", admin)) for _ in range(2)]
+        outcomes = []
+        for call in calls:
+            try:
+                outcomes.append(call.result(timeout=8)["status"])
+            except ValueError as error:
+                assert "only 'approved'" in str(error)
+                outcomes.append("refused")
+    assert sorted(outcomes) == ["paid", "refused"]
+    with database.db_session() as db:
+        InvoiceRepository(db, admin).update_invoice(target, status="approved")
+    with pytest.raises(ValueError, match="already.*used"):
+        run(process_payment(target, "bank_transfer", reference, "", admin))
