+def test_release_authority_and_concurrent_writes(monkeypatch, tmp_path):
+    path = tmp_path / "concurrent.db"
+    admin, _, _, _, args, _ = prepare(monkeypatch, "TH606", path)
+    target = args["invoice_id"]
+    first = run(flag_invoice_for_review(target, "review", "hold", "", admin))["transfer_flag_id"]
+    with pytest.raises(PermissionError):
+        release_flag(identity(admin.namespace, "vendor"), target, first)
+    assert not release_flag(identity("another-namespace", "admin"), target, first)
+    second = run(flag_invoice_for_review(target, "review", "reject", "", admin))["transfer_flag_id"]
+    assert release_flag(admin, target, first)
+    assert transfer(admin, args, target)["actions"] == ["reject"]
+    assert release_flag(admin, target, second)
+    entered = Event()
+    resume = Event()
+
+    def pause_after_lock(db, invoice):
+        entered.set()
+        assert resume.wait(5)
+        return active_flags(db, invoice)
+
+    with patch.object(stripe, "active_flags", side_effect=pause_after_lock), ThreadPoolExecutor() as executor:
+        future = executor.submit(transfer, admin, args, target)
+        try:
+            assert entered.wait(5)
+            with sqlite3.connect(path, timeout=0) as competing:
+                with pytest.raises(sqlite3.OperationalError, match="locked"):
+                    competing.execute("BEGIN IMMEDIATE")
+        finally:
+            resume.set()
+        assert future.result(timeout=6)["status"] == "completed"
+    print("SQLite writer lock verified with a second independent connection")
+
+    new_path = tmp_path / "flag-first.db"
+    shutil.copyfile(path, new_path)
+    use_database(monkeypatch, new_path)
+    change_db(new_path, "delete from payment_transactions")
+    started = Event()
+
+    def start_transfer(db):
+        started.set()
+        begin_transfer_write(db)
+
+    with database.db_session() as db, ThreadPoolExecutor() as executor:
+        begin_transfer_write(db)
+        invoice = InvoiceRepository(db, admin).get_invoice(target)
+        record_flag(db, invoice, "escalate", "review", "", "concurrency_fixture")
+        db.flush()
+        with patch.object(stripe, "begin_transfer_write", side_effect=start_transfer):
+            future = executor.submit(transfer, admin, args, target)
+            try:
+                assert started.wait(5)
+            finally:
+                db.commit()
+            assert future.result(timeout=6)["code"] == "active_flag"
+    assert not payments(new_path, target)
+
