+"""Allow one completed transfer and one receipt application per invoice."""
+
+import sqlalchemy as sa
+from alembic import op
+
+revision = "cp3_receipt_integrity"
+down_revision = "cp3_transfer_flags"
+branch_labels = None
+depends_on = None
+
+
+def upgrade():
+    db = op.get_bind()
+    if db.dialect.name != "sqlite":
+        raise RuntimeError("CP3 receipt integrity requires SQLite")
+    duplicates = db.execute(sa.text(
+        "SELECT 1 FROM payment_transactions WHERE status = 'completed' "
+        "GROUP BY namespace, invoice_id HAVING COUNT(*) > 1 LIMIT 1"
+    )).first()
+    if duplicates:
+        raise RuntimeError("Reconcile existing duplicate completed transfers before migrating")
+    op.add_column("payment_transactions", sa.Column("receipt_applied", sa.Boolean(), nullable=False, server_default="0"))
+    op.execute(
+        "UPDATE payment_transactions SET receipt_applied = 1 WHERE status = 'completed' "
+        "AND EXISTS (SELECT 1 FROM invoices WHERE invoices.id = payment_transactions.invoice_id "
+        "AND invoices.namespace = payment_transactions.namespace AND invoices.status = 'paid')"
+    )
+    op.create_index(
+        "uq_ptx_completed_invoice", "payment_transactions", ["namespace", "invoice_id"],
+        unique=True, sqlite_where=sa.text("status = 'completed'"),
+    )
+
+
+def downgrade():
+    op.drop_index("uq_ptx_completed_invoice", table_name="payment_transactions")
+    op.drop_column("payment_transactions", "receipt_applied")
