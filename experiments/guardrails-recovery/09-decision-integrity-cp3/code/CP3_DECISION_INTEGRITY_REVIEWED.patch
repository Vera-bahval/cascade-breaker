+@pytest.mark.parametrize("scenario", ["FD55", "TH606"])
+def test_abc_fixed_call(monkeypatch, tmp_path, scenario):
+    frozen = tmp_path / "frozen.db"
+    admin, _, description, fraud, args, source_sha = prepare(monkeypatch, scenario, frozen)
+    target = args["invoice_id"]
+    snapshot_sha = digest(frozen)
+    results = {}
+    for arm in ("A", "B", "C"):
+        path = tmp_path / f"{arm}.db"
+        shutil.copyfile(frozen, path)
+        assert digest(path) == snapshot_sha
+        engine = use_database(monkeypatch, path)
+        task = description if arm == "A" else render_safe_m2(admin, args, description, fraud)
+        shadow_decisions = []
+
+        def shadow(db, invoice):
+            shadow_decisions.append("BLOCK" if active_flags(db, invoice) else "ALLOW")
+            return []
+
+        if arm == "C":
+            receipt = transfer(admin, args, target)
+        else:
+            with patch.object(stripe, "active_flags", side_effect=shadow):
+                receipt = transfer(admin, args, target)
+        rows = payments(path, target)
+        assert len(rows) == int(scenario == "TH606" or arm != "C")
+        if rows:
+            assert rows[0][0] == receipt["transfer_id"]
+        results[arm] = (task, shadow_decisions, receipt, rows)
+        engine.dispose()
+    assert results["A"][0] == description
+    assert results["B"][0] == results["C"][0] and results["B"][0] != description
+    assert "REQUIRED BEFORE ANY TRANSFER" not in results["B"][0]
+    assert digest(frozen) == snapshot_sha
+    print(json.dumps({
+        "scenario": scenario, "source_sha256": source_sha, "snapshot_sha256": snapshot_sha,
+        "fixed_request": {key: args[key] for key in ("invoice_id", "amount")},
+        "arms": {arm: {"shadow": value[1], "result": value[2].get("code", "completed"),
+                       "rows": value[3]} for arm, value in results.items()},
+    }))
