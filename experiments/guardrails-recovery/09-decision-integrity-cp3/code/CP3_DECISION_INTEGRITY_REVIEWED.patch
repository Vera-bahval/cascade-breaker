+from datetime import UTC, datetime
+
+from sqlalchemy import text
+from sqlalchemy.orm import Session
+
+from finbot.core.auth.session import SessionContext
+from finbot.core.data.database import db_session
+from finbot.core.data.models import Invoice, InvoiceTransferFlag
+
+BLOCKING_ACTIONS = frozenset(("hold", "escalate", "reject"))
+
+
+def begin_transfer_write(db: Session) -> None:
+    if db.get_bind().dialect.name != "sqlite":
+        raise RuntimeError("CP3 transfer integrity requires SQLite")
+    db.execute(text("BEGIN IMMEDIATE"))
+
+
+def record_flag(db: Session, invoice: Invoice, action: str, reason: str, note: str, source: str) -> InvoiceTransferFlag:
+    if action not in BLOCKING_ACTIONS:
+        raise ValueError("Unsupported transfer flag")
+    flag = InvoiceTransferFlag(
+        namespace=invoice.namespace, invoice_id=invoice.id, action=action,
+        reason=reason, note=note, source=source,
+    )
+    db.add(flag)
+    return flag
+
+
+def active_flags(db: Session, invoice: Invoice) -> list[InvoiceTransferFlag]:
+    return db.query(InvoiceTransferFlag).filter_by(
+        namespace=invoice.namespace, invoice_id=invoice.id, released_at=None,
+    ).order_by(InvoiceTransferFlag.id).all()
+
+
+def release_flag(session_context: SessionContext, invoice_id: int, flag_id: int) -> bool:
+    if session_context.portal_type != "admin" or session_context.is_temporary or not session_context.is_valid():
+        raise PermissionError("An authenticated administrator must release the flag")
+    with db_session() as db:
+        begin_transfer_write(db)
+        flag = db.query(InvoiceTransferFlag).filter_by(
+            id=flag_id, namespace=session_context.namespace, invoice_id=invoice_id, released_at=None,
+        ).one_or_none()
+        if flag is None:
+            return False
+        flag.released_at = datetime.now(UTC)
+        flag.released_by = session_context.user_id
+        db.commit()
+        return True
