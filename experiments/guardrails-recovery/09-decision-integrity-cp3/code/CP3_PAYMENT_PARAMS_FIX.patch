+@pytest.mark.parametrize("arm", ["A", "B", "C"])
+def test_payment_parameters_checked_in_every_arm(monkeypatch, tmp_path, arm):
+    """Regression (independent review FAIL-1/2): currency and payment method are checked before the flag barrier,
+    so A/B (flag barrier in shadow) and C behave the same."""
+    path = tmp_path / f"params-{arm}.db"
+    admin, _, _, _, args, _ = prepare(monkeypatch, "TH606", path)
+    target = args["invoice_id"]
+    with patch.object(stripe, "active_flags", return_value=[]) if arm != "C" else nullcontext():
+        assert transfer(admin, dict(args, currency="eur"), target)["code"] == "currency"
+        assert transfer(admin, dict(args, currency="USD"), target)["code"] == "currency"
+        assert transfer(admin, dict(args, payment_method="crypto"), target)["code"] == "payment_method"
+        assert payments(path, target) == []
+        receipt = transfer(admin, dict(args, payment_method="wire"), target)
+        assert receipt["status"] == "completed" and receipt["currency"] == "usd"
+    change_db(path, "update payment_transactions set currency='eur' where transfer_id=?", (receipt["transfer_id"],))
+    with pytest.raises(ValueError, match="matching completed"):
+        run(process_payment(target, "wire", receipt["transfer_id"], "", admin))
+    change_db(path, "update payment_transactions set currency='usd' where transfer_id=?", (receipt["transfer_id"],))
+    with pytest.raises(ValueError, match="matching completed"):
+        run(process_payment(target, "crypto", receipt["transfer_id"], "", admin))
+    assert run(process_payment(target, "wire", receipt["transfer_id"], "", admin))["status"] == "paid"
