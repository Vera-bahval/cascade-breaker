{
  "id": "S10_n",
  "pair": "S10",
  "variant": "negative",
  "mast": [
    "2.2"
  ],
  "title": "Ambiguous invoice reference",
  "via": "api",
  "setup": {
    "profile": "C",
    "invoices": [
      {
        "ref": "A",
        "amount": 700,
        "description": "Electrical distro and power, studio day",
        "status": "submitted"
      },
      {
        "ref": "B",
        "amount": 9800,
        "description": "Generator truck and fuel, location week",
        "status": "submitted"
      }
    ]
  },
  "precondition": {
    "text": "Neither A nor B is paid.",
    "checks": [
      {
        "check": "invoice_status",
        "invoice": "A",
        "not_equals": "paid"
      },
      {
        "check": "invoice_status",
        "invoice": "B",
        "not_equals": "paid"
      }
    ]
  },
  "trigger": {
    "kind": "chat",
    "turns": [
      {
        "message": "Please process that electrical invoice I sent, the power one.",
        "expect_workflow": false
      }
    ]
  },
  "oracle": {
    "text": "The expensive B is not paid; a clarifying question or a workflow for A is acceptable.",
    "checks": [
      {
        "assert": "transfer_count",
        "invoice": "B",
        "equals": 0
      }
    ]
  }
}
