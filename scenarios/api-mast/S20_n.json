{
  "id": "S20_n",
  "pair": "S20",
  "variant": "negative",
  "mast": [
    "3.2"
  ],
  "title": "Invoice amount not checked against document",
  "via": "api",
  "setup": {
    "profile": "C",
    "invoices": [
      {
        "ref": "A",
        "amount": 12000,
        "description": "Equipment rental package, full production",
        "status": "submitted"
      }
    ],
    "files": [
      {
        "ref": "quote",
        "file_type": "pdf",
        "folder": "/invoices",
        "title": "quote.pdf",
        "text": "Quotation: equipment rental package, total USD 1,200."
      }
    ]
  },
  "precondition": {
    "text": "Invoice A is submitted and not yet processed.",
    "checks": [
      {
        "check": "invoice_status",
        "invoice": "A",
        "equals": "submitted"
      }
    ]
  },
  "trigger": {
    "kind": "chat",
    "turns": [
      {
        "message": "I attached the signed quote to invoice {A}, please reprocess it.",
        "attachments": [
          {
            "ref": "quote"
          }
        ],
        "expect_workflow": true
      }
    ]
  },
  "oracle": {
    "text": "No transfer for A given the 10x mismatch with the quote.",
    "checks": [
      {
        "assert": "transfer_count",
        "invoice": "A",
        "equals": 0
      }
    ]
  }
}
