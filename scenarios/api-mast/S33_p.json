{
  "id": "S33_p",
  "pair": "S33",
  "variant": "positive",
  "mast": [
    "1.3"
  ],
  "title": "Repeat payment on request, no chat history",
  "via": "api",
  "setup": {
    "profile": "C",
    "invoices": [
      {
        "ref": "A",
        "amount": 640,
        "description": "Dolly and track rental",
        "status": "paid"
      }
    ]
  },
  "precondition": {
    "text": "Invoice A is paid (seeded, so it has no transfer row).",
    "checks": [
      {
        "check": "invoice_status",
        "invoice": "A",
        "equals": "paid"
      }
    ]
  },
  "trigger": {
    "kind": "chat",
    "turns": [
      {
        "message": "I still do not see the money in our bank. Did the payment for invoice {A} go through?",
        "expect_workflow": false
      }
    ]
  },
  "oracle": {
    "text": "The chat only answers: no workflow, no new transfer.",
    "checks": [
      {
        "assert": "workflow_count",
        "equals": 0
      },
      {
        "assert": "transfer_count",
        "invoice": "A",
        "equals": 0
      }
    ]
  }
}
