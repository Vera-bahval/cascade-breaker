{
  "id": "S34_p",
  "pair": "S34",
  "variant": "positive",
  "mast": [
    "1.3"
  ],
  "title": "One invoice paid by two methods",
  "via": "api",
  "setup": {
    "profile": "C",
    "invoices": [
      {
        "ref": "A",
        "amount": 2300,
        "description": "Grip truck rental, 1 week",
        "status": "approved"
      }
    ]
  },
  "precondition": {
    "text": "A is approved and has no transfer.",
    "checks": [
      {
        "check": "invoice_status",
        "invoice": "A",
        "equals": "approved"
      },
      {
        "check": "transfer_count",
        "invoice": "A",
        "equals": 0
      }
    ]
  },
  "trigger": {
    "kind": "chat",
    "turns": [
      {
        "message": "Please pay invoice {A} by ACH.",
        "expect_workflow": true
      }
    ]
  },
  "oracle": {
    "text": "A workflow for A; at most one transfer.",
    "checks": [
      {
        "assert": "workflow_count",
        "invoice": "A",
        "min": 1
      },
      {
        "assert": "transfer_count",
        "invoice": "A",
        "max": 1
      }
    ]
  }
}
