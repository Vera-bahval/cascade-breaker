{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cascade-breaker/scenarios/schema.json",
  "description": "Scenario files. Field meanings: docs/scenarios/schema.md.",
  "$defs": {
    "scenario": {
      "description": "One variant of a scenario: scenarios/api-mast/S*.json and every case of scenarios/unified/suites/*.json.",
      "type": "object",
      "required": ["id", "pair", "variant", "mast", "title", "via", "trigger", "oracle"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pair": {"type": "string", "minLength": 1},
        "variant": {"enum": ["negative", "positive"]},
        "mast": {"type": "array", "items": {"$ref": "#/$defs/mast_mode"}, "uniqueItems": true},
        "title": {"type": "string"},
        "via": {
          "oneOf": [
            {"const": "api"},
            {"type": "array", "items": {"enum": ["direct", "api"]}, "minItems": 1, "uniqueItems": true}
          ]
        },
        "expected": {
          "type": "object",
          "required": ["outcome"],
          "additionalProperties": false,
          "properties": {
            "outcome": {"enum": ["stop", "pay"]},
            "reason": {"type": "array", "items": {"type": "string"}}
          }
        },
        "source": {"type": "object"},
        "setup": {"$ref": "#/$defs/setup"},
        "precondition": {
          "type": "object",
          "required": ["checks"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string"},
            "checks": {"type": "array", "items": {"$ref": "#/$defs/precondition_check"}}
          }
        },
        "trigger": {"$ref": "#/$defs/trigger"},
        "oracle": {
          "type": "object",
          "required": ["checks"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string"},
            "checks": {"type": "array", "items": {"$ref": "#/$defs/oracle_check"}, "minItems": 1}
          }
        }
      }
    },
    "mast_mode": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "3.1", "3.2", "3.3"]},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "vendor_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_name": {"type": "string"},
        "vendor_category": {"type": "string"},
        "industry": {"type": "string"},
        "services": {"type": "string"},
        "name": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "tin": {"type": "string", "maxLength": 20},
        "bank_account_number": {"type": "string"},
        "bank_name": {"type": "string"},
        "bank_routing_number": {"type": "string"},
        "bank_account_holder_name": {"type": "string"}
      }
    },
    "invoice": {
      "type": "object",
      "required": ["amount", "description"],
      "additionalProperties": false,
      "properties": {
        "amount": {"type": "number"},
        "description": {"type": "string"},
        "due_in_days": {"type": "integer"},
        "days_ago": {"type": "integer"},
        "invoice_number": {"type": "string"}
      }
    },
    "setup_invoice": {
      "type": "object",
      "required": ["ref", "amount", "description"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "amount": {"type": "number"},
        "description": {"type": "string"},
        "due_in_days": {"type": "integer"},
        "days_ago": {"type": "integer"},
        "status": {"$ref": "#/$defs/invoice_status"},
        "agent_notes": {"type": "string"}
      },
      "dependentRequired": {"agent_notes": ["status"]}
    },
    "invoice_status": {"enum": ["submitted", "processing", "approved", "rejected", "paid"]},
    "document": {
      "type": "object",
      "required": ["ref", "title", "text"],
      "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "title": {"type": "string", "description": "file name in FinDrive"},
        "text": {"type": "string"},
        "file_type": {"type": "string"},
        "folder": {"type": "string"}
      }
    },
    "turn": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "attachments": {
          "type": "array",
          "items": {"type": "object", "required": ["ref"], "additionalProperties": false,
                    "properties": {"ref": {"$ref": "#/$defs/ref"}}}
        },
        "expect_workflow": {"type": "boolean"}
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"enum": ["A", "B", "C", "D", "E", "F", "G"]},
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {"type": "string"},
            "trust_level": {"enum": ["low", "standard", "high"]},
            "risk_level": {"enum": ["low", "medium", "high"]},
            "agent_notes": {"type": "string"}
          }
        },
        "vendor": {"$ref": "#/$defs/vendor_fields"},
        "prior_vendor_ref": {"$ref": "#/$defs/ref"},
        "invoices": {"type": "array", "items": {"$ref": "#/$defs/setup_invoice"}},
        "files": {"type": "array", "items": {"$ref": "#/$defs/document"}},
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "fields"],
            "additionalProperties": false,
            "properties": {
              "target": {"enum": ["invoice", "vendor"]},
              "ref": {"$ref": "#/$defs/ref"},
              "fields": {"type": "object", "minProperties": 1}
            },
            "if": {"properties": {"target": {"const": "invoice"}}},
            "then": {"required": ["ref"]}
          }
        },
        "prepare_turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}},
        "filler": {"type": "object", "required": ["count"], "additionalProperties": false,
                   "properties": {"count": {"type": "integer", "minimum": 1}}},
        "prepare_turns_after_filler": {"type": "array", "items": {"$ref": "#/$defs/turn"}}
      },
      "dependentRequired": {"state": ["profile"]}
    },
    "trigger": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {"properties": {"kind": {"const": "chat"}, "turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}, "minItems": 1}},
         "required": ["turns"], "additionalProperties": false},
        {"properties": {"kind": {"const": "onboarding"}, "vendor": {"$ref": "#/$defs/vendor_fields"}},
         "additionalProperties": false},
        {"properties": {"kind": {"const": "invoice"}, "invoice": {"$ref": "#/$defs/invoice"}},
         "required": ["invoice"], "additionalProperties": false}
      ]
    },
    "precondition_check": {
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "check": {"enum": ["invoice_status", "transfer_count", "vendor_status", "vendor_trust", "paid_invoice_count", "fraud_flag"]},
        "invoice": {"$ref": "#/$defs/ref"},
        "ref": {"$ref": "#/$defs/ref"},
        "flag": {"type": "string"},
        "equals": {}, "not_equals": {}, "in": {"type": "array", "minItems": 1},
        "max": {"type": "number"}, "min": {"type": "number"}, "not_above": {"enum": ["low", "standard", "high"]}
      }
    },
    "oracle_check": {
      "type": "object",
      "required": ["assert"],
      "additionalProperties": false,
      "properties": {
        "assert": {"enum": ["transfer_count", "transfer_followed_approval", "transfer_account", "workflow_count",
                            "vendor_status", "vendor_trust", "systemutils_calls", "email_to_admin", "invoice_status"]},
        "invoice": {"$ref": "#/$defs/ref"},
        "ref": {"$ref": "#/$defs/ref"},
        "source": {"const": "profile"},
        "per_turn_max": {"type": "integer", "minimum": 0},
        "equals": {}, "not_equals": {}, "in": {"type": "array", "minItems": 1},
        "max": {"type": "number"}, "min": {"type": "number"}, "not_above": {"enum": ["low", "standard", "high"]}
      }
    },
    "simple_case": {
      "description": "scenarios/cases/*.json, run with `run.py prepare` and `run.py run`.",
      "type": "object",
      "required": ["via", "trigger"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "via": {"enum": ["api", "direct"]},
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor": {"$ref": "#/$defs/vendor_fields"},
            "invoices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["amount", "description"],
                "additionalProperties": false,
                "properties": {
                  "amount": {"type": "number"}, "description": {"type": "string"},
                  "due_in_days": {"type": "integer"}, "days_ago": {"type": "integer"},
                  "invoice_number": {"type": "string"}, "status": {"$ref": "#/$defs/invoice_status"}
                }
              }
            },
            "vendor_overrides": {"type": "object"},
            "onboard": {"type": "boolean"}
          }
        },
        "trigger": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["invoice", "chat", "onboarding", "orchestrator"]},
            "invoice": {"$ref": "#/$defs/invoice"},
            "message": {"type": "string"},
            "expect_workflow": {"type": "boolean"},
            "vendor": {"$ref": "#/$defs/vendor_fields"},
            "description": {"type": "string"},
            "use_setup_invoice": {"type": "integer", "minimum": 1},
            "injection": {
              "type": "object", "required": ["node", "fault"], "additionalProperties": false,
              "properties": {"node": {"type": "string"}, "fault": {"enum": ["instruction", "context_loss", "response"]}}
            }
          }
        }
      }
    },
    "base_list": {
      "description": "scenarios/unified/base.json",
      "type": "object",
      "required": ["modes"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "name", "scenario", "positive"],
            "additionalProperties": false,
            "properties": {
              "mode": {"$ref": "#/$defs/mast_mode"}, "name": {"type": "string"},
              "scenario": {"type": "string"}, "positive": {"type": "string"}
            }
          }
        }
      }
    },
    "additions_list": {
      "description": "scenarios/unified/api_additions.json",
      "type": "object",
      "required": ["modes"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "name", "pairs", "cross_workflow"],
            "additionalProperties": false,
            "properties": {
              "mode": {"$ref": "#/$defs/mast_mode"}, "name": {"type": "string"},
              "pairs": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]+$"}, "minItems": 1},
              "cross_workflow": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]+$"}}
            }
          }
        }
      }
    }
  }
}
